{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osiris.local/schemas/manifest.schema.json",
  "title": "OSIRIS plugin manifest.json",
  "description": "plugins/<id>/manifest.json — docs/SOZLESME.md §4. Rust R5'te derleme zamanında gömülür.",
  "type": "object",
  "required": ["id", "name", "version", "network_type", "description", "config_schema"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "network_type": {"enum": ["www", "tor", "i2p", "p2p", "freenet", "zeronet", "irc", "matrix", "rss", "api", "blockchain", "sdr", "custom"]},
    "author": {"type": "string", "maxLength": 200},
    "description": {"type": "string", "maxLength": 1000},
    "config_schema": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/field"}
    },
    "capabilities": {"type": "array", "items": {"type": "string", "maxLength": 50}, "uniqueItems": true},
    "requires_proxy": {"type": "boolean"},
    "schedule_default": {
      "type": "string",
      "description": "5 alanlı cron veya boş (zamanlanmaz)",
      "pattern": "^$|^[\\d,/*-]+ [\\d,/*-]+ [\\d,/*-]+ [\\d,/*-]+ [\\d,/*-]+$"
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["string", "integer", "number", "boolean", "array", "object"]},
        "required": {"type": "boolean", "description": "true ise null/boş dize kabul edilmez"},
        "default": {},
        "description": {"type": "string", "maxLength": 500}
      }
    }
  }
}
