{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osiris.local/schemas/collection_result.schema.json",
  "title": "CollectionResult",
  "description": "Bir toplama görevinin sonucu. success=false iken items boştur ve error doludur. error metni sözleşme dışıdır (insan için), yalnızca varlığı bağlayıcıdır.",
  "type": "object",
  "required": ["success", "error", "items", "metadata"],
  "additionalProperties": false,
  "properties": {
    "success": {"type": "boolean"},
    "error": {"type": ["string", "null"], "maxLength": 1000},
    "items": {"type": "array", "items": {"$ref": "collected_item.schema.json"}},
    "metadata": {"type": "object"}
  },
  "if": {"properties": {"success": {"const": false}}},
  "then": {"properties": {"items": {"maxItems": 0}, "error": {"type": "string", "minLength": 1}}},
  "else": {"properties": {"error": {"type": "null"}}}
}
