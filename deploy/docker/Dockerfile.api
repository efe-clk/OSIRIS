# OSIRIS API — uygulama imajı
# Kullanım: docker compose --profile api up -d --build
# --- Rust çekirdeği (osiris_native, PyO3) — tekerlek derleme aşaması (R4)
# Debian sürümü çalışma imajıyla aynı ya da daha eski olmalı (glibc uyumu).
FROM rust:1.99.1-slim-trixie AS native
# rust-toolchain.toml'daki bileşenleri (rustfmt/clippy) indirmesin: imajdaki sürüm aynı
ENV RUSTUP_TOOLCHAIN=1.99.1 \
    CARGO_TERM_COLOR=never
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/maturin \
 && /opt/maturin/bin/pip install --no-cache-dir maturin==1.15.0
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
RUN /opt/maturin/bin/maturin build --release --locked \
      -m crates/osiris-py/Cargo.toml --interpreter python3 --out /wheels

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Önce SDK ve dahili modüller (katman önbelleği için)
COPY osiris-sdk ./osiris-sdk
COPY osiris-collector ./osiris-collector
COPY osiris-graph ./osiris-graph
COPY osiris-query ./osiris-query
COPY osiris-alert ./osiris-alert
COPY osiris-report ./osiris-report
COPY osiris-api ./osiris-api
COPY plugins ./plugins
COPY --from=native /wheels /wheels

RUN pip install --no-cache-dir /wheels/*.whl \
    ./osiris-sdk \
    ./osiris-collector \
    ./osiris-graph \
    ./osiris-query \
    ./osiris-alert \
    ./osiris-report \
    ./osiris-api \
 && for req in plugins/*/requirements.txt; do \
        pip install --no-cache-dir -r "$req"; \
    done

EXPOSE 8000

# nobody kullanıcısının yazabileceği rapor dizini (ReportGenerator varsayılanı)
RUN mkdir -p /app/reports && chown nobody:nogroup /app/reports

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

USER nobody

CMD ["osiris-api"]
