# OSIRIS pipeline işçisi — Redis Streams tüketicisi + KVKK saklama temizliği
# Kullanım: python models/download.py && docker compose --profile worker up -d --build
# Modeller imaja GÖMÜLMEZ: ./models salt-okunur bağlanır (yoksa yalnızca regex, vektörsüz).
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OSIRIS_MODEL_DIR=/app/models \
    HF_HUB_OFFLINE=1

WORKDIR /app

COPY osiris-sdk ./osiris-sdk
COPY osiris-pipeline ./osiris-pipeline

RUN pip install --no-cache-dir ./osiris-sdk "./osiris-pipeline[embedding,ner]" \
 && mkdir -p /app/models

USER nobody

CMD ["osiris-pipeline", "--loop", "--interval", "5", "--batch", "50"]
