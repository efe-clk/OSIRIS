# OSIRIS Rust servisleri (R5): pipeline işçisi, collector zamanlayıcısı, gölge karşılaştırma.
# Kullanım: python models/download.py && docker compose --profile worker up -d --build
# Modeller imaja GÖMÜLMEZ: ./models salt-okunur bağlanır (yoksa yalnızca regex, vektörsüz).
FROM rust:1.99.1-slim-trixie AS build
# rust-toolchain.toml'daki bileşenleri (rustfmt/clippy) indirmesin: imajdaki sürüm aynı
ENV RUSTUP_TOOLCHAIN=1.99.1 \
    CARGO_TERM_COLOR=never
RUN apt-get update \
 && apt-get install -y --no-install-recommends g++ ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
# manifest.json ve username-search site DB'leri derleme zamanında gömülür
COPY plugins ./plugins
RUN cargo build --release --locked -p osiris-server \
 && cp target/release/osiris-server /osiris-server

FROM debian:trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /app/models
COPY --from=build /osiris-server /usr/local/bin/osiris-server
ENV OSIRIS_MODEL_DIR=/app/models
WORKDIR /app
USER nobody
ENTRYPOINT ["osiris-server"]
CMD ["pipeline", "--loop", "--interval", "5", "--batch", "50"]
