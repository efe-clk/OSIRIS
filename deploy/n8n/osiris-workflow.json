{
  "name": "OSIRIS — Yeni Veri Uyarısı",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "minutes", "minutesInterval": 15}]
        }
      },
      "id": "trigger",
      "name": "Zamanlayıcı",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "feed_url", "name": "feed_url", "value": "https://www.example.com/feed.xml", "type": "string"},
            {"id": "query", "name": "query", "value": "fidye", "type": "string"}
          ]
        },
        "options": {}
      },
      "id": "settings",
      "name": "Ayarlar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "http://osiris-api:8000/collect",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ plugin_id: 'rss', config: { feed_url: $json.feed_url } }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type", "value": "application/json"},
            {"name": "X-API-Key", "value": "={{ $env.OSIRIS_API_KEY }}"}
          ]
        },
        "options": {"timeout": 60000}
      },
      "id": "collect",
      "name": "OSIRIS Topla",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "http://osiris-api:8000/search",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: $('Ayarlar').item.json.query, limit: 20 }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type", "value": "application/json"},
            {"name": "X-API-Key", "value": "={{ $env.OSIRIS_API_KEY }}"}
          ]
        },
        "options": {"timeout": 30000}
      },
      "id": "search",
      "name": "OSIRIS Arama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    }
  ],
  "connections": {
    "Zamanlayıcı": {"main": [[{"node": "Ayarlar", "type": "main", "index": 0}]]},
    "Ayarlar": {"main": [[{"node": "OSIRIS Topla", "type": "main", "index": 0}]]},
    "OSIRIS Topla": {"main": [[{"node": "OSIRIS Arama", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"}
}
