# OSIRIS — Ortam değişkenleri örneği
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# cp .env.example .env

# Veritabanı
POSTGRES_PASSWORD=change_me_strong_password

# MinIO nesne depolama
MINIO_ROOT_USER=osiris
MINIO_ROOT_PASSWORD=change_me_strong_password

# N8N otomasyon
N8N_USER=admin
N8N_PASSWORD=change_me_strong_password

# OSIRIS API
# JWT imza sırrı — API anahtarından FARKLI olmalı (yedeği yok; boşsa /auth/token 503 döner)
# openssl rand -hex 32
OSIRIS_JWT_SECRET=change_me_long_random_secret
OSIRIS_DATABASE_URL=postgresql://osiris:change_me_strong_password@localhost:5432/osiris
OSIRIS_REDIS_URL=redis://localhost:6379/0
# API kimlik doğrulama — ZORUNLU: boş bırakılırsa API başlamaz.
# Üretimde mutlaka güçlü bir değer atayın: openssl rand -hex 32
OSIRIS_API_KEY=
# Yalnızca güvenilir ağda, anahtarsız açık mod (her çağıran admin olur). Üretimde KULLANMAYIN.
# OSIRIS_INSECURE_OPEN=1
# CORS izinli arayüz adresleri (virgülle ayrılmış)
OSIRIS_CORS_ORIGINS=http://localhost:3000

# KVKK veri saklama (gün). Kaynak başına sources.retention_days bunu ezer; 0 = varsayılan kapalı
OSIRIS_RETENTION_DAYS=180
# Pipeline döngüsünde temizlik aralığı (sn; 0 = kapalı)
OSIRIS_RETENTION_INTERVAL=3600
